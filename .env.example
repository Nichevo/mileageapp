# Copy to .env (gitignored) and fill in. Values are injected at build time with --dart-define.
# Google OAuth client for Sheets sync (Android client ID from Google Cloud console)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Spreadsheet to sync to. Leave blank to pick one in the app.
GOOGLE_SHEET_ID=
# Dropbox app key for CSV/JSON backups
DROPBOX_APP_KEY=
# Android release signing (key.properties is gitignored; this just documents the keys)
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEY_ALIAS=
KEY_PASSWORD=
