<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by scripts/widget_previews.py: sample data for the widget picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_icon_bg"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_widget_chart"/>
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="2026 so far"/>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:textColor="@color/widget_text"
        android:textSize="18sp"
            android:text="12,480 km · $2,140"/>
    <TextView
        android:id="@+id/widget_economy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/widget_subtext"
        android:textSize="13sp"
            android:text="6.9 L/100 km average"/>
    <TextView
        android:id="@+id/widget_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/widget_accent"
        android:textSize="13sp"
        android:textStyle="bold"
            android:text="WOF in 12 days"/>
</LinearLayout>
